{
  "compilerOptions": {
    //  1. CẤU HÌNH BIÊN DỊCH
    "target": "es2020" /* Đời JavaScript khi dịch ra  */,
    "module": "commonjs" /* Gom code dịch ra dạng commonjs */,
    "esModuleInterop": true /* Giúp dùng import kiểu mới cho cả thư viện dùng require cũ  */,

    //  2. QUẢN LÝ THƯ MỤC VÀO/RA
    "rootDir": "./src" /* Nơi chứa code TypeScript gốc */,
    "outDir": "./dist" /* Nơi chứa code JavaScript sau khi dịch */,
    "allowJs": true /* Cho phép dùng chung cả file .js và .ts */,

    //  3. KIỂM TRA LỖI & ĐỘ NGHIÊM NGẶT
    "strict": true /* Bắt buộc định nghĩa rõ kiểu dữ liệu */,
    "forceConsistentCasingInFileNames": true /* Bắt lỗi nếu viết sai chữ hoa/thường ở tên file */,
    "skipLibCheck": true /* Bỏ qua kiểm tra lỗi trong node_modules để dịch nhanh hơn */,
    "strictNullChecks": true /* báo lỗi khi 1 giá trị có thể là null */,

    //  4. HỖ TRỢ PHÁT TRIỂN & DEBUG
    "sourceMap": true /* Tạo file bản đồ giúp debug trực tiếp trên file .ts */,

    //  5. CẤU HÌNH ĐƯỜNG DẪN ẢO (absolute path ts)
    "paths": {
      /* Tạo tên viết tắt cho thư mục để import ngắn gọn, không dùng ../ */
      "config/*": ["./src/config/*"],
      "controllers/*": ["./src/controllers/*"],
      "models/*": ["./src/models/*"],
      "routes/*": ["./src/routes/*"],
      "services/*": ["./src/services/*"],
      "helper/*": ["./src/helper/*"],
      "middlware/*": ["./src/middleware/*"]
    }
  },

  //  6. PHẠM VI QUẢN LÝ FILE
  "include": [
    "src/**/*",
    "tsconfig.json"
  ] /* Thư mục và file được TypeScript quét và dịch */,

  "exclude": [
    "node_modules",
    "dist"
  ] /* Thư mục bị bỏ qua để tiết kiệm tài nguyên */,

  "ts-node": {
    "files": true
  } /* bật chế độ đọc các file theo danh sách trong tsconfig */
}
