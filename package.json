  "type": "commonjs",
  "main": "dist/app.js",
  "module": "NodeNext",
  "moduleResolution": "NodeNext",
  "scripts": {
    "build": "prisma generate",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "nodemon",
    "dev": "nodemon",
    "start:debug": "nodemon --inspect=9229 -e ts,tsx --exec node -r ts-node/register -r tsconfig-paths/register ./src/app.ts",
    "_ghi_chu_1": "nodemon: Tự động khởi động lại server khi lưu file (Ctrl + S).",
    "_ghi_chu_2": "--inspect=9229: Mở cổng debug 9229 để VS Code nhảy vào bắt chấm đỏ.",
    "_ghi_chu_3": "-e ts,tsx: Chỉ canh chừng sự thay đổi của file đuôi .ts và .tsx.",
    "_ghi_chu_4": "--exec node -r ts-node/register: Bộ dịch cấp tốc giúp Node hiểu được TypeScript.",
    "_ghi_chu_5": "./src/app.ts: File chạy chính của dự án."
  },
  "nodemonConfig": {
    "watch": [
      "src",
      ".env"
    ],
    "ext": "ts",
    "ignore": [
      "node_modules"
    ],
    "exec": "ts-node -r tsconfig-paths/register ./src/app.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "6.0.0",
    "dotenv": "16.4.7",
    "ejs": "3.1.10",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "multer": "1.4.5-lts.1",
    "mysql2": "3.24.3",
    "passport": "0.7.0",
    "passport-local": "1.0.0",
    "uuid": "11.0.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.0",
    "@types/express-session": "1.19.0",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.7",
    "@types/passport": "1.0.17",
    "@types/passport-local": "1.0.38",
    "nodemon": "3.1.9",
    "prisma": "7.10.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3"
  }
