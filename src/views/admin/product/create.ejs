                $("#avatarPreview").attr("src", imgURL);
                $("#avatarPreview").css({ "display": "block" });
            });
        });
    </script> -->
    <script>
        // DOMContentLoaded load xong html r chay sk duoi
        document.addEventListener("DOMContentLoaded", () => {
            const avatarFile = document.querySelector("#imageFile");
            const avatarPreview = document.querySelector("#imagePreview");

            if (!avatarFile || !avatarPreview) return;

            // Thay cho .change()
            avatarFile.addEventListener("change", function (e) {
                if (!e.target.files || e.target.files.length === 0) return;

                // 1. GIẢI PHÓNG RAM CŨ 
                const oldSrc = avatarPreview.src;
                if (oldSrc && oldSrc.startsWith("blob:")) {
                    URL.revokeObjectURL(oldSrc);
                }

                // 2. TẠO LINK BLOB MỚI
                const imgURL = URL.createObjectURL(e.target.files[0]);

                // 3. HIỂN THỊ LÊN GIAO DIỆN
                avatarPreview.src = imgURL;
                avatarPreview.style.display = "block";
            });
        });

    </script>
</head>

<body class="sb-nav-fixed">
    <!-- header -->
    <%- include('../layout/header.ejs'); -%>

        <!-- sidebar -->
        <div id="layoutSidenav">
            <%- include('../layout/sidenav.ejs'); -%>
                <div id="layoutSidenav_content">

                    <!-- content -->
                    <main>
                        <div class="container-fluid px-4">
                            <h1 class="mt-4">Manage Products</h1>
                            <ol class="breadcrumb mb-4">
                                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                                <li class="breadcrumb-item"><a href="/admin/product">Products</a></li>
                                <li class="breadcrumb-item active">Create Product</li>
                            </ol>
                            <div class="row">
                                <div class="col-8 mx-auto">
                                    <!-- Thông báo lỗi validate -->

                                    <% if (Array.isArray(errors)) { %>
                                        <% errors.forEach(function (iss) { %>
                                            <div class="alert alert-danger mb-3">
                                                <%= iss.message %> |
                                                    Lỗi tại trường <%= iss.path[0] %>
                                            </div>
                                            <% }) %>
                                                <% } %>



                                                    <h3>Create a product</h3>
                                                    <form action="/admin/handle-create-product" method="post"
                                                        enctype="multipart/form-data">

                                                        <div>

                                                            <div class="row">
                                                                <div class="mb-3 col-6">
                                                                    <label for="name_" class="form-label">Name</label>
                                                                    <input value="<%= oldData.name %>" required
                                                                        name="name" type="text" class="form-control"
                                                                        id="name_">
                                                                </div>
                                                                <div class="mb-3 col-6">
                                                                    <label for="price_" class="form-label">Price</label>
                                                                    <input value="<%= oldData.price %>" required
                                                                        name="price" type="number" class="form-control"
                                                                        id="price_">
                                                                </div>
                                                            </div>

                                                            <div class="mb-3">
                                                                <label for="detailDesc_" class="form-label">Detail
                                                                    Desciption:
                                                                </label>
                                                                <textarea required class="form-control" id="detailDesc_"
                                                                    rows="3"
                                                                    name="detailDesc"><%= oldData.detailDesc %></textarea>
                                                            </div>

                                                            <div class="row">
                                                                <div class="mb-3 col-6">
                                                                    <label for="shortDesc_" class="form-label">Short
                                                                        Description</label>
                                                                    <input value="<%= oldData.shortDesc %>" required
                                                                        name="shortDesc" type="text"
                                                                        class="form-control" id="shortDesc_">
                                                                </div>
                                                                <div class="mb-3 col-6">
                                                                    <label for="quantity_"
                                                                        class="form-label">Quantity</label>
                                                                    <input min="1" step="1" type="number"
                                                                        value="<%= oldData.quantity %>" required
                                                                        name="quantity" class="form-control"
                                                                        id="quantity_">
                                                                </div>
                                                            </div>

                                                            <div class="row">
                                                                <div class="mb-3 col-6">
                                                                    <label class="form-label">Factory</label>
                                                                    <select name="factory" class="form-select">
                                                                        <option value="APPLE">Apple (MacBook)</option>
                                                                        <option value="ASUS">Asus</option>
                                                                        <option value="LENOVO">Lenovo</option>
                                                                        <option value="DELL">Dell</option>
                                                                        <option value="LG">LG</option>
                                                                        <option value="ACER">Acer</option>
                                                                    </select>
                                                                </div>
                                                                <div class="mb-3 col-6">
                                                                    <label class="form-label">Target</label>
                                                                    <select name="target" class="form-select">
                                                                        <option value="GAMING">Gaming</option>
                                                                        <option value="SINHVIEN-VANPHONG">Sinh viên -
                                                                            Văn phòng
                                                                        </option>
                                                                        <option value="THIET-KE-DO-HOA">Thiết kế đồ họa
                                                                        </option>
                                                                        <option value="MONG-NHE">Mỏng nhẹ</option>
                                                                        <option value="DOANH-NHAN">Doanh nhân</option>
                                                                    </select>
                                                                </div>
                                                            </div>



                                                            <div class="mb-3">
                                                                <label for="avatarFile" class="form-label">Image</label>
                                                                <input accept=".png, .jpg, .jpeg, .svg" name="image"
                                                                    class="form-control" type="file" id="imageFile">
                                                            </div>
                                                            <img style="max-height: 250px; display: none;"
                                                                alt="avatar preview" id="imagePreview" />


                                                            <div class="mb-3">
                                                                <button type="submit"
                                                                    class="btn btn-warning">Submit</button>
                                                            </div>
                                                        </div>
                                                    </form>
                                </div>
                            </div>
                        </div>

                    </main>

                    <!-- footer -->
                    <%- include('../layout/footer.ejs'); -%>
                </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
            crossorigin="anonymous"></script>
        <script src="/admin/js/scripts.js"></script>


</body>

</html>