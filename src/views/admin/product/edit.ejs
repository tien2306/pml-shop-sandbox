                $("#imagePreview").attr("src", imgURL);
                $("#imagePreview").css({ "display": "block" });
            });
        });
    </script> -->
    <script>
        // DOMContentLoaded load xong html r chay sk duoi
        document.addEventListener("DOMContentLoaded", () => {
            const imageFile = document.querySelector("#imageFile");
            const imagePreview = document.querySelector("#imagePreview");

            if (!imageFile || !imagePreview) return;

            // Thay cho .change()
            imageFile.addEventListener("change", function (e) {
                if (!e.target.files || e.target.files.length === 0) return;

                // 1. GIẢI PHÓNG RAM CŨ 
                const oldSrc = imagePreview.src;
                if (oldSrc && oldSrc.startsWith("blob:")) {
                    URL.revokeObjectURL(oldSrc);
                }

                // 2. TẠO LINK BLOB MỚI
                const imgURL = URL.createObjectURL(e.target.files[0]);

                // 3. HIỂN THỊ LÊN GIAO DIỆN
                imagePreview.src = imgURL;
                imagePreview.style.display = "block";
            });
        });

    </script>
</head>

<body class="sb-nav-fixed">
    <!-- header -->
    <%- include('../layout/header.ejs'); -%>

        <!-- sidebar -->
        <div id="layoutSidenav">
            <%- include('../layout/sidenav.ejs'); -%>
                <div id="layoutSidenav_content">

                    <!-- content -->
                    <main>
                        <div class="container-fluid px-4">
                            <h1 class="mt-4">Manage Products</h1>
                            <ol class="breadcrumb mb-4">
                                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                                <li class="breadcrumb-item"><a href="/admin/product">Products</a></li>
                                <li class="breadcrumb-item active">Update Product</li>
                            </ol>
                            <div class="row">
                                <div class="col-8 mx-auto">
                                    <!-- Thông báo lỗi validate -->

                                    <% if (Array.isArray(errors)) { %>
                                        <% errors.forEach(function (iss) { %>
                                            <div class="alert alert-danger mb-3">
                                                <%= iss.message %> |
                                                    Lỗi tại trường <%= iss.path[0] %>
                                            </div>
                                            <% }) %>
                                                <% } %>

                                                    <h3>Update a product</h3>
                                                    <form action="/admin/handle-update-product" method="post"
                                                        enctype="multipart/form-data">

                                                        <div>
                                                            <!-- ID -->
                                                            <input type="hidden" name="id" value="<%= id %>">

                                                            <!-- Name và Price -->
                                                            <div class="row">
                                                                <div class="mb-3 col-6">
                                                                    <label for="name_" class="form-label">Name</label>
                                                                    <input value="<%= oldData.name %>" required
                                                                        name="name" type="text" class="form-control"
                                                                        id="name_">
                                                                </div>
                                                                <div class="mb-3 col-6">
                                                                    <label for="price_" class="form-label">Price</label>
                                                                    <input value="<%= oldData.price %>" required
                                                                        name="price" type="number" class="form-control"
                                                                        id="price_">
                                                                </div>
                                                            </div>

                                                            <!-- Desciption Detail -->
                                                            <div class="mb-3">
                                                                <label for="detailDesc_" class="form-label">Detail
                                                                    Desciption:
                                                                </label>
                                                                <textarea required class="form-control" id="detailDesc_"
                                                                    rows="3"
                                                                    name="detailDesc"><%= oldData.detailDesc %></textarea>
                                                            </div>

                                                            <!-- Desciption short và quantity -->
                                                            <div class="row">
                                                                <div class="mb-3 col-6">
                                                                    <label for="shortDesc_" class="form-label">Short
                                                                        Description</label>
                                                                    <input value="<%= oldData.shortDesc %>" required
                                                                        name="shortDesc" type="text"
                                                                        class="form-control" id="shortDesc_">
                                                                </div>
                                                                <div class="mb-3 col-6">
                                                                    <label for="quantity_"
                                                                        class="form-label">Quantity</label>
                                                                    <input min="1" step="1" type="number"
                                                                        value="<%= oldData.quantity %>" required
                                                                        name="quantity" class="form-control"
                                                                        id="quantity_">
                                                                </div>
                                                            </div>

                                                            <!-- Factory và Target-->
                                                            <div class="row">
                                                                <!-- Thẻ Select Factory -->
                                                                <div class="mb-3 col-6">
                                                                    <label class="form-label">Factory</label>
                                                                    <select name="factory" class="form-select">
                                                                        <% factoryOptions.forEach(function(item) { %>
                                                                            <option value="<%= item.value %>" <%=oldData
                                                                                && oldData.factory===item.value
                                                                                ? 'selected' : '' %>>
                                                                                <%= item.name %>
                                                                            </option>
                                                                            <% }); %>
                                                                    </select>
                                                                </div>

                                                                <!-- Thẻ Select Target -->
                                                                <div class="mb-3 col-6">
                                                                    <label class="form-label">Target</label>
                                                                    <select name="target" class="form-select">
                                                                        <% targetOptions.forEach(function(item) { %>
                                                                            <option value="<%= item.value %>" <%=oldData
                                                                                && oldData.target===item.value
                                                                                ? 'selected' : '' %>>
                                                                                <%= item.name %>
                                                                            </option>
                                                                            <% }); %>
                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <!-- Image -->
                                                            <div class="mb-3">
                                                                <label for="imageFile" class="form-label">Image</label>
                                                                <input accept=".png, .jpg, .jpeg, .svg" name="image"
                                                                    class="form-control" type="file" id="imageFile">
                                                            </div>
                                                            <% if (product.image) { %>
                                                                <img style="max-height: 250px; display: block;"
                                                                    alt="avatar preview" id="imagePreview"
                                                                    src="/images/product/<%= product.image %>" />
                                                                <% } else { %>
                                                                    <img style="max-height: 250px; display: none;"
                                                                        alt="avatar preview" id="imagePreview" />
                                                                    <% } %>


                                                                        <div class="mb-3">
                                                                            <button type="submit"
                                                                                class="btn btn-warning">Submit</button>
                                                                        </div>
                                                        </div>
                                                    </form>
                                </div>
                            </div>
                        </div>

                    </main>

                    <!-- footer -->
                    <%- include('../layout/footer.ejs'); -%>
                </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
            crossorigin="anonymous"></script>
        <script src="/admin/js/scripts.js"></script>


</body>

</html>