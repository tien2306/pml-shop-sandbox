<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="Trang đăng ký tài khoản" />
    <meta name="author" content="" />
    <title>Đăng ký - Laptopshop</title>
    <!-- Dùng CSS của template hiện tại -->
    <link href="/admin/css/styles.css" rel="stylesheet" />
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <style>
        body {
            /* Hình nền xám nhạt nhẹ nhàng */
            background-color: #f4f6f9;
        }

        .register-card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

        .btn-register {
            background-color: #81c408;
            /* Màu xanh theme của client */
            border-color: #81c408;
            color: white;
            transition: all 0.3s ease;
        }

        .btn-register:hover {
            background-color: #6da606;
            border-color: #6da606;
            color: white;
            transform: translateY(-2px);
        }

        .text-theme {
            color: #81c408 !important;
        }
    </style>
</head>

<body>
    <div id="layoutAuthentication">
        <div id="layoutAuthentication_content">
            <main>
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-7 col-md-9">
                            <div class="card register-card mt-5 mb-5">
                                <div class="card-header bg-white text-center pt-4 pb-2 border-0">
                                    <h3 class="font-weight-light my-2 fw-bold" style="color: #333;">TẠO TÀI KHOẢN</h3>
                                    <p class="text-muted small mb-0">Đăng ký thành viên Laptopshop ngay hôm nay</p>
                                </div>

                                <div class="card-body p-4 p-sm-5 pt-3">
                                    <form action="/register" method="POST">
                                        <% if (Array.isArray(errors)) { %>
                                            <% errors.forEach(function (iss) { %>
                                                <div class="alert alert-danger mb-3">
                                                    <%= iss.message %> |
                                                        Lỗi tại trường <%= iss.path[0] %>
                                                </div>
                                                <% }) %>
                                                    <% } %>
                                                        <!-- Họ và Tên -->
                                                        <div class="form-floating mb-3">
                                                            <input name="fullName" class="form-control"
                                                                id="inputFullName" type="text"
                                                                placeholder="Nguyễn Văn A" required
                                                                value="<%= oldData.fullName %>" />
                                                            <label for="inputFullName">Họ và Tên</label>
                                                        </div>

                                                        <!-- Email -->
                                                        <div class="form-floating mb-3">
                                                            <input name="email" class="form-control" id="inputEmail"
                                                                type="email" placeholder="name@example.com" required
                                                                value="<%= oldData.email %>" />
                                                            <label for="inputEmail">Địa chỉ Email</label>
                                                        </div>

                                                        <!-- Passwords -->
                                                        <div class="row mb-3">
                                                            <div class="col-md-6 mb-3 mb-md-0">
                                                                <div class="form-floating">
                                                                    <input name="password" class="form-control"
                                                                        id="inputPassword" type="password"
                                                                        placeholder="Create a password" required
                                                                        value="<%= oldData.password %>" />
                                                                    <label for="inputPassword">Mật khẩu</label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <div class="form-floating">
                                                                    <input name="confirmPassword" class="form-control"
                                                                        id="inputPasswordConfirm" type="password"
                                                                        placeholder="Confirm password" required
                                                                        value="<%= oldData.confirmPassword %>" />
                                                                    <label for="inputPasswordConfirm">Xác nhận mật
                                                                        khẩu</label>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Submit Button -->
                                                        <div class="d-grid gap-2 mt-4 mb-4">
                                                            <button type="submit"
                                                                class="btn btn-register btn-lg fw-bold">
                                                                Đăng ký
                                                            </button>
                                                        </div>

                                                        <!-- Back to home -->
                                                        <div class="text-center">
                                                            <a class="text-muted small text-decoration-none" href="/">
                                                                <i class="fas fa-arrow-left me-1"></i> Quay lại trang
                                                                chủ
                                                            </a>
                                                        </div>
                                    </form>
                                </div>

                                <!-- Footer (Login link) -->
                                <div class="card-footer text-center py-4 bg-light border-0"
                                    style="border-radius: 0 0 10px 10px;">
                                    <div class="small">
                                        <span class="text-muted">Đã có tài khoản? </span>
                                        <a href="/login" class="text-theme text-decoration-none fw-bold">
                                            Đăng nhập ngay
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
        crossorigin="anonymous"></script>
</body>

</html>